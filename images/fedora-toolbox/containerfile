# The build toolbox image: the container-dnf image (BASE, the build's
# pos-dnf) made a toolbox image. New builds make their toolboxes from it
# (BUILD.md "Toolboxes").
ARG BASE
FROM $BASE

ENV NAME=pos-fedora-toolbox VERSION=latest
LABEL com.github.containers.toolbox="true" \
      name="$NAME" \
      version="$VERSION" \
      usage="This image is meant to be used with the toolbox command" \
      summary="Base image for creating toolbox containers"

# toolbox runs sudo for its user. Nothing installs /etc/sudoers and the
# PAM configuration: POS's sudoers is in /pos/share/factory, POS has no PAM
# configuration for sudo, and pos-fedora stands in for Fedora's sudo and
# pam packages, which have them.
COPY sudoers-toolbox /etc/sudoers.d/toolbox
COPY pam-sudo /etc/pam.d/sudo
RUN install -m 0440 /pos/share/factory/etc/sudoers /etc/sudoers && \
    chmod 0440 /etc/sudoers.d/toolbox && chmod 0644 /etc/pam.d/sudo

CMD /pos/bin/bash
