# The build toolbox image: the container-dnf image (BASE, the build's
# pos-dnf) made a toolbox image. New builds make their toolboxes from it
# (BUILD.md "Toolboxes").
ARG BASE
FROM $BASE

ENV NAME=pos-fedora-toolbox VERSION=latest
LABEL com.github.containers.toolbox="true" \
      name="$NAME" \
      version="$VERSION" \
      usage="This image is meant to be used with the toolbox command" \
      summary="Base image for creating toolbox containers"

# toolbox runs sudo for its user, whom it puts in wheel. POS's
# /etc/sudoers (from the factory tree) has no wheel rule; this adds one.
# sudo's PAM configuration is POS's (pos-integration).
COPY sudoers-toolbox /etc/sudoers.d/toolbox
RUN chmod 0440 /etc/sudoers.d/toolbox

CMD /pos/bin/bash
