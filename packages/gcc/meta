# The sdk compiler, built by gcc-bootstrap against the full libraries it
# runs on. Those are built by gcc-bootstrap too; everything else requires
# gcc and is built by this compiler. The build also produces gcc-runtime,
# which gcc requires; a build does not need its own outputs to run.
build-requires pos-link
requires glibc gcc-runtime binutils linux-headers
requires gmp mpfr mpc zlib zstd
provides gcc-bootstrap
obsoletes gcc-bootstrap
outputs gcc-runtime
